    {
      "parameters": {
        "jsCode": "const TIPOS = ['POWER_OUTAGE','POWER_RESTORATION','VOLTAGE_SPIKE','VOLTAGE_SAG','HEARTBEAT','UNKNOWN'];\nconst entrada = Array.isArray($json.body) ? $json.body : ($json.body ? [$json.body] : [$json]);\nreturn entrada.map((e) => {\n  const id_medidor = parseInt(e.id_medidor ?? e.meter_id, 10);\n  const ts = e.timestamp_evento ?? e.timestamp ?? new Date().toISOString();\n  let tipo = String(e.tipo_evento ?? e.type ?? '').toUpperCase().trim();\n  if (!TIPOS.includes(tipo)) tipo = 'UNKNOWN';\n  if (!Number.isInteger(id_medidor)) {\n    throw new Error('id_medidor inválido: ' + JSON.stringify(e));\n  }\n  return { json: {\n    id_medidor,\n    timestamp_evento: new Date(ts).toISOString(),\n    tipo_evento: tipo,\n    procesado: false\n  }};\n});"
      },
      "id": "26a44bc1-87d8-4e8f-8cb4-74c5e5f497c5",
