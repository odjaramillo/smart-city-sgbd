# =============================================================================
# Configuración de Supabase — Proyecto Smart City SGBD
# =============================================================================
# Copiá este archivo como .env y completá con tus credenciales reales.
# El .env NO se commitea (está en .gitignore).
# =============================================================================

# URL del proyecto Supabase (Project URL)
# Formato: https://<project-id>.supabase.co
# Ejemplo: https://abc123def456.supabase.co
SUPABASE_URL=

# API Key de servicio (service_role key) — NO usar anon key
# La encontrás en: Supabase Dashboard > Project Settings > API > service_role
SUPABASE_SERVICE_ROLE_KEY=

# Puerto y host para conexiones directas (opcional, para psql o scripts Python)
# Por defecto: 5432
SUPABASE_DB_HOST=aws-0-us-east-1.pooler.supabase.com
SUPABASE_DB_PORT=6543
SUPABASE_DB_NAME=postgres
SUPABASE_DB_USER=postgres
SUPABASE_DB_PASSWORD=

# =============================================================================
# USO:
#   1. Completá SUPABASE_URL y SUPABASE_SERVICE_ROLE_KEY como mínimo.
#   2. Para ejecutar SQL directamente con psql:
#        psql "postgresql://postgres:<password>@<host>:6543/postgres"
#   3. Para ejecutar el smoke test, pegá el contenido de los archivos .sql
#      en el SQL Editor de Supabase en este orden:
#        01-ddl-modelo-estrella.sql
#        02-sp-reconciliacion-elt.sql
#        03-vistas-analiticas.sql
#        04-datos-semilla.sql
#        05-verificacion-smoke-test.sql
# =============================================================================
